#!/usr/bin/env bash
# rtp-node: run a Reticulum node that talks to its peers over raw Ethernet
# (EtherType 0x88B5) through `rtp`, without any IP between nodes.
#
# Everything lives next to this script: the Python venv, the node config,
# its identities and received files. Nothing touches ~/.reticulum.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
BIN="$DIR/rtp"
VENV="$DIR/.venv"
NODE="$DIR/node"
RNS_VERSION="1.6.0"
export PYTHONUNBUFFERED=1

die() { echo "rtp-node: $*" >&2; exit 1; }

usage() {
    cat <<EOF
usage: rtp-node <command> [args]

  setup                 create the Python venv with Reticulum $RNS_VERSION
  start <iface>         run the node on <iface> (foreground, Ctrl+C to stop)
  id                    print this node's probe destination hash
  probe <hash> [n]      probe another node (default: 5 probes)
  status                show interface status
  listen                accept file transfers into ./received
  send <file> <hash>    send a file to a node running 'listen'

Run 'start' in one terminal and the other commands in another.
EOF
}

need_venv() {
    [[ -x "$VENV/bin/rnsd" ]] || die "Reticulum not installed, run './rtp-node setup' first"
}

need_node() {
    [[ -f "$NODE/config" ]] || die "node not configured, run './rtp-node start <iface>' first"
}

cmd_setup() {
    if command -v uv >/dev/null; then
        uv venv -q --allow-existing "$VENV"
        uv pip install -q --python "$VENV/bin/python" "rns==$RNS_VERSION"
    else
        command -v python3 >/dev/null || die "neither uv nor python3 found"
        python3 -m venv "$VENV"
        "$VENV/bin/pip" install -q "rns==$RNS_VERSION"
    fi
    echo "Reticulum $("$VENV/bin/rnsd" --version | awk '{print $2}') installed in $VENV"
}

# Opens the interface for real: with stdin closed, rtp binds its socket and
# exits right away. Prints rtp's own error on failure.
try_open() { # iface
    local err
    err="$("$BIN" "$1" </dev/null 2>&1 >/dev/null)" && return 0
    printf '%s\n' "$err" | grep -v '^\[rtp\] hint:' >&2
    return 1
}

ensure_cap() { # iface
    try_open "$1" 2>/dev/null && return
    if [[ $EUID -ne 0 ]]; then
        echo "rtp needs CAP_NET_RAW to send raw Ethernet frames; granting it with sudo:"
        sudo setcap cap_net_raw+ep "$BIN"
        try_open "$1" 2>/dev/null && return
    fi
    try_open "$1" || true
    local opts
    opts="$(findmnt -no OPTIONS -T "$BIN" 2>/dev/null || true)"
    if [[ ",$opts," == *,nosuid,* ]]; then
        die "$DIR is on a nosuid filesystem, where file capabilities are ignored.
Extract the bundle somewhere else (e.g. your home directory) and retry."
    fi
    if [[ "$(grep -s '^NoNewPrivs:' /proc/self/status | awk '{print $2}')" == 1 ]]; then
        die "this shell runs with no_new_privs (sandbox?), so file capabilities are ignored."
    fi
    die "cannot open $1 even with CAP_NET_RAW; run as root to rule out other restrictions."
}

write_config() { # iface
    mkdir -p "$NODE"
    cat > "$NODE/config" <<EOF
# Generated by rtp-node. Only the raw Ethernet interface is enabled, so no
# IP is used between nodes. The shared instance uses its own name and ports
# so it does not clash with a regular rnsd on the same host.
[reticulum]
  enable_transport = Yes
  share_instance = Yes
  instance_name = rtp
  shared_instance_port = 47428
  instance_control_port = 47429
  respond_to_probes = Yes

[logging]
  loglevel = 4

[interfaces]
  [[Ethernet]]
    type = PipeInterface
    interface_enabled = Yes
    command = $BIN $1
    respawn_delay = 2
EOF
}

cmd_start() {
    local iface="${1:-}"
    [[ -n "$iface" ]] || die "usage: rtp-node start <iface>"
    if command -v ip >/dev/null; then
        ip link show dev "$iface" >/dev/null 2>&1 || die "no such interface: $iface (see 'ip link')"
    fi
    need_venv
    ensure_cap "$iface"
    write_config "$iface"
    echo "Starting node on $iface. Check its hash with './rtp-node id' in another terminal."
    exec "$VENV/bin/rnsd" --config "$NODE"
}

cmd_id() {
    need_venv
    local idf="$NODE/storage/transport_identity"
    [[ -f "$idf" ]] || die "no identity yet, start the node first"
    "$VENV/bin/python" - "$idf" <<'EOF'
import sys, RNS
identity = RNS.Identity.from_file(sys.argv[1])
print(RNS.Destination.hash(identity, "rnstransport", "probe").hex())
EOF
}

case "${1:-}" in
    setup)  cmd_setup ;;
    start)  shift; cmd_start "$@" ;;
    id)     cmd_id ;;
    probe)
        [[ -n "${2:-}" ]] || die "usage: rtp-node probe <hash> [n]"
        need_venv; need_node
        exec "$VENV/bin/rnprobe" --config "$NODE" -n "${3:-5}" -t 15 rnstransport.probe "$2" ;;
    status)
        need_venv; need_node
        exec "$VENV/bin/rnstatus" --config "$NODE" ;;
    listen)
        need_venv; need_node
        mkdir -p "$DIR/received"
        exec "$VENV/bin/rncp" --config "$NODE" -v -l -n -s "$DIR/received" ;;
    send)
        [[ -n "${2:-}" && -n "${3:-}" ]] || die "usage: rtp-node send <file> <hash>"
        need_venv; need_node
        exec "$VENV/bin/rncp" --config "$NODE" -P "$2" "$3" ;;
    -h|--help|help|"") usage ;;
    *) usage; exit 2 ;;
esac
